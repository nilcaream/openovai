#!/bin/sh
#
# ovai — the one command of an OpenOv AI instance.
#
# It works out which instance it belongs to from where it sits, makes sure the toolkit's own
# Node.js and Claude Code are there, and hands the rest over to that node. Nothing here is written
# at install time and no path is baked in, so an instance can be moved and this still works.
#
# POSIX sh, because it runs before any node exists and the machine owes it nothing more than
# lib/runtime.sh needs: sh, curl or wget, tar, sha256sum and uname.

set -eu

die() { printf 'ovai: %s\n' "$*" >&2; exit 1; }

bin_dir="$(cd -- "$(dirname -- "$0")" && pwd -P)"
root="$(dirname -- "${bin_dir}")"

[ -f "${root}/openovai.json" ] ||
    die "${root} is not an OpenOv AI instance: no openovai.json in it"

runtime="${root}/lib/runtime.sh"
[ -f "${runtime}" ] || die "the runtime bootstrap is missing at ${runtime}"

# Whatever is missing is fetched, one line per fetch; with both already there this says nothing.
# It is the same command whether this is the first start of a fresh install or the first start
# after an update that pinned a newer runtime.
sh "${runtime}" ensure || die "the runtime could not be fetched, so nothing can run"

exec "$(sh "${runtime}" node-path)" "${root}/lib/ovai.mjs" --root "${root}" "$@"
