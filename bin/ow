#!/usr/bin/env bash
set -euo pipefail

# ow — the name this instance's command used to be typed under. It is `ovai` now.
#
# It is here because of what an update does: it replaces the whole of bin/, so an instance that
# took a version shipping only the new name would lose the old one the moment it caught up — and
# the line the update prints on its way out is printed by the process it started as, which knows
# no name but the one it was launched under. Whoever types the old name is told the new one and
# gets what they asked for anyway, which is the difference between a rename and a break.
#
# Nothing is checked here. Every floor an instance has to clear is checked by the command this
# hands over to, and checking them twice would be two answers to keep in step for no gain.
#
# It goes away two releases after the one that renamed the command.

bin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

echo "ow is now ovai — running ${bin_dir}/ovai" >&2
exec "${bin_dir}/ovai" "$@"
